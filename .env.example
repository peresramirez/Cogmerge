# cp .env.example .env  and fill these in. No local infra, everything hosted.

# --- LLM (Cognee uses this for graph extraction during cognify) ---
LLM_API_KEY=sk-...

# --- Qdrant Cloud -------------------------------------------------
# Create a free cluster at https://cloud.qdrant.io -> copy the endpoint + API key.
# The URL must include https:// and the :6333 port.
VECTOR_DB_PROVIDER=qdrant
VECTOR_DB_URL=https://xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx.us-east-0-1.aws.cloud.qdrant.io:6333
VECTOR_DB_KEY=your-qdrant-cloud-api-key
VECTOR_DATASET_DATABASE_HANDLER=qdrant

# --- Which repo this memory belongs to (scopes every node_set) ----
COGMERGE_REPO=acme/payments-api

# --- Optional: Cognee Cloud ---------------------------------------
# Leave BLANK to run the cognee library locally against your own Qdrant Cloud
# cluster (recommended -- it is the only setup where the Qdrant dashboard shows
# YOUR collections, which is worth having on screen during the demo).
# Set both to route through Cognee's hosted API instead.
COGNEE_BASE_URL=
COGNEE_API_KEY=
