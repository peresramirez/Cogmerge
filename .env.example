# cp .env.example .env  and fill in. No local infra — everything is hosted.

# Which backend to use: "cloud" (default, zero install) or "qdrant".
COGMERGE_BACKEND=cloud

# Which repo this memory belongs to. Scopes every node_set tag.
COGMERGE_REPO=acme/payments-api


# ── Backend: cloud ────────────────────────────────────────────────
# Cognee Cloud REST API. Cognee does the LLM work server-side, so no
# LLM key is needed here. This is the fastest path to a working demo.
COGNEE_BASE_URL=https://tenant-<your-tenant>.aws.cognee.ai
COGNEE_API_KEY=
COGNEE_TENANT_ID=
COGNEE_USER_ID=


# ── Backend: qdrant ───────────────────────────────────────────────
# Runs the cognee library locally, writing embeddings into a Qdrant
# cluster you own — so the collections show up in YOUR dashboard.
#
# Requires Python >=3.10,<3.14 (cognee will not install on 3.14) and:
#   pip install cognee cognee-community-vector-adapter-qdrant
#
# The bare Qdrant Cloud endpoint has no port; REST needs :6333.
QDRANT_API_URL=https://<cluster-id>.<region>.aws.cloud.qdrant.io:6333
QDRANT_API_KEY=
VECTOR_DB_PROVIDER=qdrant
VECTOR_DATASET_DATABASE_HANDLER=qdrant

# The library path needs its own LLM key for embeddings + graph extraction.
LLM_API_KEY=
